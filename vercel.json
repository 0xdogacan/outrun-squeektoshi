{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "accelerometer=(self), gyroscope=(self), geolocation=(), camera=(), microphone=()" }
      ]
    }
  ]
}
